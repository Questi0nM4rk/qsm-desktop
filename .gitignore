*.tmp
*.log
.cache/
# Quickshell's language-server shim: a symlink into a per-boot XDG_RUNTIME_DIR
# path, regenerated by qs at runtime — never portable, never committed.
.qmlls.ini

# qmllint shadow import root + report (regenerated by scripts/qml-lint)
.qmllint/

# graphify code-graph output (regenerated by the graphify tool)
graphify-out/

# Agent scratch: worktrees are merged back and deleted after each task.
.opencode/

# Agent task backlog lives in docs/BACKLOG.md.
.codeagent/
