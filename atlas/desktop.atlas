# The desktop atlas: a fixed set of named screens, run with `drive atlas run atlas/desktop.atlas`.
# Coordinates are logical px on the 1920x1080 @ 1.25 output; the pointer parks at 1100,700.
desktop ~/Projects/qsm-desktop/shell
hypr ~/.config/hypr/hyprland.lua
mock ~/Projects/qsm-desktop/atlas/mock.json
check ~/Projects/qsm-desktop/scripts/atlas-check
# The shell counts pending updates 5 s after it starts: every journey begins after that, or the
# badge lands between a shot and its item tree.
ready 6
# Mock notifications expire in 10 minutes, never within a journey: a low one expired 3 s after
# its post, before or after the shot depending on timing.

journey rest
  move-to 1100 700
  shot rest

journey windows
  exec foot -o cursor.blink=no sh -c 'sleep 900'
  wait-clients 1
  move-to 1100 700
  shot one
  exec foot -o cursor.blink=no sh -c 'sleep 900'
  wait-clients 2
  shot two
  exec foot -o cursor.blink=no sh -c 'sleep 900'
  wait-clients 3
  shot three

journey rail
  move-to 32 32
  hover-wait 500
  shot entry-1 @Rail
  move-to 1100 700
  move-to 32 68
  hover-wait 500
  shot entry-2 @DescriptionPopout
  move-to 1100 700
  move-to 32 104
  hover-wait 500
  shot entry-3 @DescriptionPopout
  move-to 1100 700
  move-to 32 180
  hover-wait 500
  shot clock @MonthCalendar
  move-to 1100 700
  move-to 32 418
  hover-wait 500
  shot workspaces @WorkspaceStrip
  move-to 1100 700
  move-to 32 628
  hover-wait 500
  shot battery @BatteryPopoutContent
  move-to 1100 700
  move-to 32 676
  hover-wait 500
  shot quick-actions @QuickActionsColumn
  move-to 1100 700
  move-to 32 712
  hover-wait 500
  shot network @NetworkPopoutContent
  move-to 1100 700
  move-to 32 748
  hover-wait 500
  shot bluetooth @BluetoothPopoutContent
  move-to 1100 700
  move-to 32 784
  hover-wait 500
  shot sound @SoundPopoutContent
  move-to 1100 700
  move-to 32 832
  hover-wait 500
  shot session @DescriptionPopout

journey launcher
  move-to 1100 700
  key SUPER SPACE
  shot open @LauncherSurface
  type foot
  shot query @LauncherSurface

journey quick-controls
  move-to 1100 700
  key SUPER A
  shot open @LauncherSurface

journey clipboard
  move-to 1100 700
  key SUPER V
  shot open @ClipboardSurface

journey cheatsheet
  move-to 1100 700
  key SUPER SLASH
  shot open @CheatSheetSurface

journey overview
  move-to 1100 700
  key SUPER W
  shot open @PanelSurface/FocusScope

journey session
  move-to 1100 700
  key CTRL ALT DELETE
  shot open @SessionSurface/FocusScope

journey panel
  move-to 800 12
  click
  move-to 1100 700
  shot open

journey panel-tabs
  move-to 1100 700
  ipc toggle dashboard
  # CPU usage is a delta of two samples 2 s apart: with this Hyprland config it shows 4.3 s
  # after the panel opens (measured three times), so the shot waits well past it.
  hover-wait 7000
  shot dashboard @PanelSurface/FocusScope
  ipc toggle media
  shot media @PanelSurface/FocusScope
  ipc toggle performance
  # The network rate needs two detailed samples and the sparkline two rates; samples run every
  # 2 s and the first detailed one can come a tick after the tab opens.
  hover-wait 10000
  shot battery @PanelSurface/FocusScope
  ipc toggle workspaces
  shot workspaces @PanelSurface/FocusScope

journey osd
  move-to 1100 700
  move-to 1530 432
  hover-wait 600
  shot open @OsdContent


journey notifications
  move-to 1100 700
  ipc notifyPost "Anna Nováková" "Oběd ve 12? Mám stůl u okna." normal 600000 0 false
  ipc notifyPost "Build finished" "qsm-shell main: 63/63 stories passed" low 600000 0 false
  ipc notifyPost "Battery low" "12 % left, plug in soon" critical 0 0 false
  shot popups @NotificationStack
  ipc toggle notifications
  shot centre @NotificationCenterSurface

journey clipboard-data
  exec sh -c 'printf "ssh qs@salonek.local\n" | cliphist store; printf "https://github.com/hyprwm/aquamarine/commit/7bb8bdf\n" | cliphist store; printf "Lunch at 12 by the window\n" | cliphist store'
  move-to 1100 700
  hover-wait 500
  key SUPER V
  shot open @ClipboardSurface

journey launcher-commands
  move-to 1100 700
  key SUPER SPACE
  type >
  shot commands @LauncherSurface
  type calc 12*(3+4)
  shot calc @LauncherSurface
  key CTRL A
  type >kill
  shot kill @LauncherSurface
  key CTRL A
  type >theme
  shot theme @LauncherSurface
  key CTRL A
  type >action
  shot action @LauncherSurface

journey session-armed
  move-to 1100 700
  key CTRL ALT DELETE
  key DOWN
  key DOWN
  key DOWN
  key DOWN
  key RETURN
  hover-wait 300
  shot-now armed @SessionSurface/FocusScope

journey lock
  move-to 1100 700
  key CTRL ALT DELETE
  key RETURN
  shot locked

journey notifications-more
  move-to 1100 700
  ipc notifyPost "Anna Nováková" "Tady je delší zpráva, aby bylo vidět, jak se tělo notifikace zalomí: zítra v 9 ve druhém patře, přines prosím ty výkresy a nabíječku, ta moje odešla." normal 600000 0 false
  ipc notifyPost "Mail" "3 new messages" normal 600000 0 false
  ipc notifyPost "Calendar" "Standup in 5 minutes" normal 600000 0 false
  ipc notifyPost "Update" "12 packages can be upgraded" low 600000 0 false
  ipc notifyPost "Disk almost full" "/ has 2 GiB left" critical 0 0 false
  ipc notifyPost "Music" "Now playing: Nils Frahm – Says" low 600000 0 false
  shot overflow @NotificationStack
  ipc notifyDnd true
  shot dnd @NotificationStack

journey quick-actions-detail
  move-to 32 676
  hover-wait 500
  move-to 96 676
  move-to 96 604
  hover-wait 500
  shot detail-1 @DescriptionPopout
  move-to 96 640
  hover-wait 500
  shot detail-2 @DescriptionPopout
  move-to 96 676
  hover-wait 500
  shot detail-3 @DescriptionPopout
  move-to 96 712
  hover-wait 500
  shot detail-4 @DescriptionPopout
  move-to 96 748
  hover-wait 500
  shot detail-5 @ColorPickContent

journey rail-collapsed
  move-to 1100 700
  ipc railToggle
  shot collapsed
  move-to 2 432
  hover-wait 600
  shot peek @Rail

journey focus-mode
  exec foot -o cursor.blink=no sh -c 'sleep 900'
  wait-clients 1
  move-to 1100 700
  ipc focusEnterTest
  shot focus

journey fullscreen
  exec foot -o cursor.blink=no sh -c 'sleep 900'
  wait-clients 1
  move-to 1100 700
  dispatch hl.dsp.window.fullscreen({ mode = "fullscreen", action = "toggle" })
  # The window and the rail take a moment to answer; a still screen can come before them.
  hover-wait 1500
  shot fullscreen

journey urgent
  eval hl.window_rule({ name = "atlas-urgent", match = { class = "^atlas-urgent$" }, workspace = "10 silent" })
  exec foot -o cursor.blink=no --app-id atlas-urgent -o bell.urgent=yes sh -c 'sleep 3; printf "\\a"; sleep 900'
  wait-clients 1
  # The bell rings 3 s after foot starts, and foot can take a second to start in the slot.
  hover-wait 6000
  move-to 1100 700
  shot urgent @WorkspaceStrip

journey theme-dusk
  move-to 1100 700
  ipc theme mountain-dusk
  shot rest
  move-to 32 784
  hover-wait 500
  shot sound @SoundPopoutContent

# The battery runs low while the desktop is up: UPower announces it and the rail follows.
journey battery-low
  mock .dbus.system["org.freedesktop.UPower"]["/org/freedesktop/UPower/devices/DisplayDevice"]["org.freedesktop.UPower.Device"].Energy 4.05
  mock .dbus.system["org.freedesktop.UPower"]["/org/freedesktop/UPower/devices/DisplayDevice"]["org.freedesktop.UPower.Device"].TimeToEmpty 1519
  mock .dbus.system["org.freedesktop.UPower"]["/org/freedesktop/UPower/devices/DisplayDevice"]["org.freedesktop.UPower.Device"].Percentage 12
  move-to 1100 700
  shot rest
  move-to 32 628
  hover-wait 500
  shot battery @BatteryPopoutContent

# The network states the owner's priority order names, one mock of the nm record each: the
# before shots of the network glyph work. Today the rail and the popout do not read the Internet
# state, so portal and no-internet look like the connected shots. The shell reads NetworkManager
# on a 10 s poll, so each mock waits out one poll; the rail is shot at rest, the popout hovered.
journey network-states
  move-to 1100 700
  mock .nm.connectivity "portal"
  hover-wait 11000
  shot rail-portal @Rail
  move-to 32 712
  hover-wait 500
  shot portal @NetworkPopoutContent
  move-to 1100 700
  mock .nm.connectivity "none"
  hover-wait 11000
  shot rail-no-internet @Rail
  move-to 32 712
  hover-wait 500
  shot no-internet @NetworkPopoutContent
  move-to 1100 700
  mock .nm.connectivity "full"
  mock .nm.device[0].STATE "connecting (getting IP configuration)"
  hover-wait 11000
  shot rail-connecting @Rail
  move-to 32 712
  hover-wait 500
  shot connecting @NetworkPopoutContent
  move-to 1100 700
  mock .nm.device[0].STATE "connected"
  mock .nm.device[1].STATE "connected"
  mock .nm.device[1].CONNECTION "Wired connection 1"
  hover-wait 11000
  shot rail-ethernet @Rail
  move-to 32 712
  hover-wait 500
  shot ethernet @NetworkPopoutContent
  move-to 1100 700
  mock .nm.device[1].STATE "unavailable"
  mock .nm.device[1].CONNECTION ""
  mock .nm.connectivity "none"
  mock .nm.device[0].STATE "disconnected"
  mock .nm.device[0].CONNECTION ""
  mock .nm.wifi[0]["IN-USE"] ""
  mock .nm.connection[0].ACTIVE "no"
  hover-wait 11000
  shot rail-disconnected @Rail
  move-to 32 712
  hover-wait 500
  shot disconnected @NetworkPopoutContent
  move-to 1100 700
  mock .nm.radio[0].WIFI "disabled"
  mock .nm.device[0].STATE "unavailable"
  hover-wait 11000
  shot rail-radio-off @Rail
  move-to 32 712
  hover-wait 500
  shot radio-off @NetworkPopoutContent
  move-to 1100 700
  mock .nm.running false
  hover-wait 11000
  shot rail-nm-unavailable @Rail
  move-to 32 712
  hover-wait 500
  shot nm-unavailable @NetworkPopoutContent

# The battery states UPower reports, one change of the display device each; the shell follows
# UPower's PropertiesChanged, so no wait beyond the settle.
journey battery-states
  mock .dbus.system["org.freedesktop.UPower"]["/org/freedesktop/UPower/devices/DisplayDevice"]["org.freedesktop.UPower.Device"].Percentage 3
  mock .dbus.system["org.freedesktop.UPower"]["/org/freedesktop/UPower/devices/DisplayDevice"]["org.freedesktop.UPower.Device"].Energy 1.01
  mock .dbus.system["org.freedesktop.UPower"]["/org/freedesktop/UPower/devices/DisplayDevice"]["org.freedesktop.UPower.Device"].TimeToEmpty 380
  move-to 1100 700
  shot rail-critical @Rail
  move-to 32 628
  hover-wait 500
  shot critical @BatteryPopoutContent
  move-to 1100 700
  mock .dbus.system["org.freedesktop.UPower"]["/org/freedesktop/UPower"]["org.freedesktop.UPower"].OnBattery false
  mock .dbus.system["org.freedesktop.UPower"]["/org/freedesktop/UPower/devices/DisplayDevice"]["org.freedesktop.UPower.Device"].State 1
  mock .dbus.system["org.freedesktop.UPower"]["/org/freedesktop/UPower/devices/DisplayDevice"]["org.freedesktop.UPower.Device"].TimeToEmpty 0
  mock .dbus.system["org.freedesktop.UPower"]["/org/freedesktop/UPower/devices/DisplayDevice"]["org.freedesktop.UPower.Device"].TimeToFull 2700
  mock .dbus.system["org.freedesktop.UPower"]["/org/freedesktop/UPower/devices/DisplayDevice"]["org.freedesktop.UPower.Device"].EnergyRate 24.5
  mock .dbus.system["org.freedesktop.UPower"]["/org/freedesktop/UPower/devices/DisplayDevice"]["org.freedesktop.UPower.Device"].Percentage 64
  mock .dbus.system["org.freedesktop.UPower"]["/org/freedesktop/UPower/devices/DisplayDevice"]["org.freedesktop.UPower.Device"].Energy 21.62
  hover-wait 500
  shot rail-charging @Rail
  move-to 32 628
  hover-wait 500
  shot charging @BatteryPopoutContent
  move-to 1100 700
  mock .dbus.system["org.freedesktop.UPower"]["/org/freedesktop/UPower/devices/DisplayDevice"]["org.freedesktop.UPower.Device"].State 4
  mock .dbus.system["org.freedesktop.UPower"]["/org/freedesktop/UPower/devices/DisplayDevice"]["org.freedesktop.UPower.Device"].TimeToFull 0
  mock .dbus.system["org.freedesktop.UPower"]["/org/freedesktop/UPower/devices/DisplayDevice"]["org.freedesktop.UPower.Device"].EnergyRate 0
  mock .dbus.system["org.freedesktop.UPower"]["/org/freedesktop/UPower/devices/DisplayDevice"]["org.freedesktop.UPower.Device"].Percentage 100
  mock .dbus.system["org.freedesktop.UPower"]["/org/freedesktop/UPower/devices/DisplayDevice"]["org.freedesktop.UPower.Device"].Energy 33.78
  hover-wait 500
  shot rail-full @Rail
  move-to 32 628
  hover-wait 500
  shot full @BatteryPopoutContent

journey launcher-empty
  move-to 1100 700
  key SUPER SPACE
  type zzqx
  shot no-results @LauncherSurface

# States the inventory knows and no journey shoots yet: BlueZ is not faked, PipeWire changes only
# at start, and the update count is read 5 s after start and then every 30 min.
todo @BluetoothPopoutContent radio-off
todo @BluetoothPopoutContent connected-device
todo @BluetoothPopoutContent pairing
todo @SoundPopoutContent output-muted
todo @SoundPopoutContent no-output-device
todo @NotificationCenterSurface empty
todo @ClipboardSurface empty
todo @OsdContent brightness
todo @DescriptionPopout updates-up-to-date
todo @PanelSurface/FocusScope opened-by-the-handle
