#!/usr/bin/env bash
# The Style.backend contract, checked from the consumer's side against what the
# library answers when asked.
#
# The library resolves every value as `backend?.x ?? Tokens.x`. A consumer that
# declares x shadows the library's value: the two drift apart and nothing
# warns. So this desktop answers only what it owns, and the library answers
# everything else:
#
#   - the colour roles of its themes, the fonts and the mode flags;
#   - size-table entries it ADDS by name, never one the library already has;
#   - its own layout and policy, under names Style never exposes.
#
# The library's names come from scripts/public-names.qml, which asks the live
# Style and Motion what they expose, and its size presets from
# tokens/deep-night.json with the documented rule that a type without its own
# table shares the Control ladder. No library source is read.
#
# It fails when Theme re-types a name Style exposes, when Theme restates a
# library size preset, when a theme role is missing from Theme, when any QML
# reads `Tokens`, when any QML reads a Theme name that Theme does not declare
# (that read is the library's value, spelled with the wrong object), and when
# any QML reads a Style or Motion name the library does not expose.
set -euo pipefail
cd "$(dirname "$0")/.."
python3 -I - "$@" <<'PY'
import json, pathlib, re, subprocess, sys

lib = pathlib.Path('vendor/qsm-shell')
style = (lib / 'qml/QsmShell/Style/Style.qml').read_text()
tokens = json.loads((lib / 'tokens/deep-night.json').read_text())
theme = pathlib.Path('shell/theme/Theme.qml').read_text()

def code(text):
    return re.sub(r'//.*', '', text)

asked = set(re.findall(r'backend\?\.(\w+)', style))
declared = set(re.findall(r'^    (?:readonly )?property\s+\w+\s+(\w+)\b', code(theme), re.M))
declared |= set(re.findall(r'^    function\s+(\w+)', code(theme), re.M))

role_sets = {f.name: set(json.loads(f.read_text())['roles']) for f in sorted(pathlib.Path('shell/themes').glob('*.json'))}
roles = set.union(*role_sets.values())
owned = roles | {'fontFamily', 'technicalFontFamily', 'reducedMotion', 'reducedEffects', 'sizes'}

problems = []

for name in sorted((asked & declared) - owned):
    problems.append(f'Theme re-types the library value "{name}": delete it and read Style.{name}')

for file, found in role_sets.items():
    for name in sorted(roles - found):
        problems.append(f'themes/{file} has no role "{name}": regenerate it with scripts/derive-theme.ts')
for name in sorted(roles - declared):
    problems.append(f'Theme does not answer the theme role "{name}"')

sizes = re.search(r'property var sizes:\s*\(\{(.*?)\n    \}\)', theme, re.S)
for kind, body in re.findall(r'(\w+):\s*\{([^}]*)\}', sizes.group(1) if sizes else ''):
    table = tokens['sizes'].get(kind, tokens['sizes']['Control'])
    for preset in re.findall(r'(\w+):\s*\d+', body):
        if preset in table:
            problems.append(f'Theme.sizes.{kind}.{preset} restates a library preset: delete it')

tracked = subprocess.run(['git', 'ls-files', '--', '*.qml'], capture_output=True, text=True, check=True).stdout.split()
for path in tracked:
    text = code(pathlib.Path(path).read_text())
    if re.search(r'\bTokens\b', text):
        problems.append(f'{path} reads Tokens: read Style')
    if path == 'shell/theme/Theme.qml':
        continue
    for name in sorted(set(re.findall(r'(?<![\w.])Theme\.(\w+)', text)) - declared - {'qml'}):
        problems.append(f'{path} reads Theme.{name}, which Theme does not declare: read Style.{name}')

if problems:
    print(f'theme contract: {len(problems)} problem(s)')
    for problem in problems:
        print(f'  {problem}')
    sys.exit(1)
print(f'theme contract: Theme answers {len(declared & owned)} owned names and re-types none of the {len(asked)} the library asks for')
PY
