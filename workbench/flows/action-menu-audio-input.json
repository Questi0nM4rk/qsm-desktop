{
  "version": 1,
  "key": "action-menu-audio-input",
  "target": { "story": "action-menu-audio" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "detail", "equals": "sound" },
    { "type": "key", "target": "menu", "key": "Up" },
    { "type": "expect", "observable": "selected-identity", "equals": "audio:output-mute" },
    { "type": "key", "target": "menu", "key": "Enter" },
    { "type": "expect", "observable": "output-muted", "equals": true },
    { "type": "expect", "observable": "selected-identity", "equals": "audio:output-mute" },
    { "type": "key", "target": "menu", "key": "Enter" },
    { "type": "expect", "observable": "output-muted", "equals": false },
    { "type": "action", "name": "open-volume" },
    { "type": "expect", "observable": "editor-open", "equals": true },
    { "type": "expect", "observable": "input-region", "equals": "editor" },
    { "type": "key", "target": "volume-editor", "key": "Up" },
    { "type": "expect", "observable": "input-region", "equals": "menu" },
    { "type": "write", "target": "menu", "text": "/" },
    { "type": "expect", "observable": "input-region", "equals": "search" },
    { "type": "write", "target": "search", "text": "neio/" },
    { "type": "expect", "observable": "query", "equals": ">action neio/" },
    { "type": "reset" },
    { "type": "expect", "observable": "output-muted", "equals": false },
    { "type": "expect", "observable": "editor-open", "equals": false },
    { "type": "await", "observable": "menu-ready", "equals": true },
    { "type": "pointer", "target": "mute-row", "event": "click" },
    { "type": "expect", "observable": "output-muted", "equals": true },
    { "type": "pointer", "target": "mute-row", "event": "click" },
    { "type": "expect", "observable": "output-muted", "equals": false },
    { "type": "pointer", "target": "volume-row", "event": "click" },
    { "type": "await", "observable": "editor-open", "equals": true }
  ]
}
