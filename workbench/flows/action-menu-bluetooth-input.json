{
  "version": 1,
  "key": "action-menu-bluetooth-input",
  "target": { "story": "action-menu-bluetooth" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "detail", "equals": "bluetooth" },
    { "type": "expect", "observable": "bluetooth-count", "equals": 3 },
    { "type": "key", "target": "menu", "key": "Enter" },
    { "type": "await", "observable": "bluetooth-enabled", "equals": false },
    { "type": "key", "target": "menu", "key": "Enter" },
    { "type": "await", "observable": "bluetooth-enabled", "equals": true },
    { "type": "key", "target": "menu", "key": "Up" },
    { "type": "key", "target": "menu", "key": "Up" },
    { "type": "expect", "observable": "selected-identity", "equals": "bluetooth-device:00:11:22:33:44:55" },
    { "type": "key", "target": "menu", "key": "Enter" },
    { "type": "await", "observable": "bluetooth-first-connected", "equals": false },
    { "type": "key", "target": "menu", "key": "Enter" },
    { "type": "await", "observable": "bluetooth-first-connected", "equals": true },
    { "type": "control", "group": "devices", "option": "next-operation-fails" },
    { "type": "key", "target": "menu", "key": "Enter" },
    { "type": "await", "observable": "bluetooth-state", "equals": "failed" },
    { "type": "expect", "observable": "bluetooth-first-connected", "equals": true },
    { "type": "key", "target": "menu", "key": "Enter" },
    { "type": "await", "observable": "bluetooth-state", "equals": "completed" },
    { "type": "control", "group": "devices", "option": "empty" },
    { "type": "expect", "observable": "bluetooth-count", "equals": 0 },
    { "type": "reset" },
    { "type": "expect", "observable": "bluetooth-count", "equals": 3 },
    { "type": "expect", "observable": "bluetooth-state", "equals": "idle" },
    { "type": "control", "group": "devices", "option": "several" },
    { "type": "await", "observable": "menu-ready", "equals": true },
    { "type": "pointer", "target": "bluetooth-radio", "event": "click" },
    { "type": "await", "observable": "bluetooth-enabled", "equals": false },
    { "type": "pointer", "target": "bluetooth-radio", "event": "click" },
    { "type": "await", "observable": "bluetooth-enabled", "equals": true },
    { "type": "await", "observable": "menu-ready", "equals": true },
    { "type": "pointer", "target": "bluetooth-device-row", "event": "click" },
    { "type": "await", "observable": "bluetooth-first-connected", "equals": false },
    { "type": "pointer", "target": "bluetooth-device-row", "event": "click" },
    { "type": "await", "observable": "bluetooth-first-connected", "equals": true },
    { "type": "reset" },
    { "type": "control", "group": "devices", "option": "next-operation-fails" },
    { "type": "key", "target": "menu", "key": "Up" },
    { "type": "key", "target": "menu", "key": "Up" },
    { "type": "key", "target": "menu", "key": "Up" },
    { "type": "expect", "observable": "selected-identity", "equals": "bluetooth-forget:forget-00:11:22:33:44:55" },
    { "type": "key", "target": "menu", "key": "Enter" },
    { "type": "expect", "observable": "confirmation", "equals": "forget-00:11:22:33:44:55" },
    { "type": "key", "target": "menu", "key": "Enter" },
    { "type": "await", "observable": "bluetooth-state", "equals": "failed" },
    { "type": "expect", "observable": "bluetooth-forget-reading", "equals": "Device refused the operation · Enter to retry" },
    { "type": "key", "target": "menu", "key": "Enter" },
    { "type": "expect", "observable": "confirmation", "equals": "forget-00:11:22:33:44:55" },
    { "type": "key", "target": "menu", "key": "Enter" },
    { "type": "await", "observable": "bluetooth-state", "equals": "completed" },
    { "type": "expect", "observable": "bluetooth-count", "equals": 2 }
  ]
}
