{
  "version": 1,
  "key": "action-menu-wifi-input",
  "target": { "story": "action-menu-wifi" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "detail", "equals": "network" },
    { "type": "expect", "observable": "wifi-count", "equals": 4 },
    { "type": "key", "target": "menu", "key": "Up" },
    { "type": "key", "target": "menu", "key": "Up" },
    { "type": "key", "target": "menu", "key": "Up" },
    { "type": "expect", "observable": "selected-identity", "equals": "wifi-network:Studio Guest" },
    { "type": "key", "target": "menu", "key": "Enter" },
    { "type": "expect", "observable": "network-editor-open", "equals": true },
    { "type": "write", "target": "wifi-password", "text": "neio/pass" },
    { "type": "expect", "observable": "password-length", "equals": 9 },
    { "type": "key", "target": "wifi-password", "key": "Enter" },
    { "type": "await", "observable": "wifi-state", "equals": "completed" },
    { "type": "expect", "observable": "network-editor-open", "equals": false },
    { "type": "expect", "observable": "wifi-guest-connected", "equals": true },
    { "type": "expect", "observable": "selected-identity", "equals": "wifi-network:Studio Guest" },
    { "type": "key", "target": "menu", "key": "Enter" },
    { "type": "await", "observable": "wifi-state", "equals": "completed" },
    { "type": "expect", "observable": "wifi-guest-connected", "equals": false },
    { "type": "control", "group": "networks", "option": "next-connect-fails" },
    { "type": "key", "target": "menu", "key": "Enter" },
    { "type": "write", "target": "wifi-password", "text": "retry/pass" },
    { "type": "key", "target": "wifi-password", "key": "Enter" },
    { "type": "await", "observable": "wifi-state", "equals": "failed" },
    { "type": "expect", "observable": "network-editor-open", "equals": true },
    { "type": "write", "target": "wifi-password", "text": "neio/retry" },
    { "type": "key", "target": "wifi-password", "key": "Enter" },
    { "type": "await", "observable": "wifi-state", "equals": "completed" },
    { "type": "expect", "observable": "wifi-guest-connected", "equals": true },
    { "type": "control", "group": "networks", "option": "empty" },
    { "type": "expect", "observable": "wifi-count", "equals": 0 },
    { "type": "reset" },
    { "type": "expect", "observable": "wifi-count", "equals": 4 },
    { "type": "expect", "observable": "wifi-state", "equals": "idle" },
    { "type": "expect", "observable": "network-editor-open", "equals": false },
    { "type": "control", "group": "networks", "option": "several" },
    { "type": "await", "observable": "menu-ready", "equals": true },
    { "type": "pointer", "target": "wifi-radio", "event": "click" },
    { "type": "expect", "observable": "confirmation", "equals": "wifi-off" },
    { "type": "expect", "observable": "wifi-enabled", "equals": true },
    { "type": "pointer", "target": "wifi-radio", "event": "click" },
    { "type": "await", "observable": "wifi-enabled", "equals": false },
    { "type": "pointer", "target": "wifi-radio", "event": "click" },
    { "type": "await", "observable": "wifi-enabled", "equals": true },
    { "type": "await", "observable": "menu-ready", "equals": true },
    { "type": "pointer", "target": "wifi-secured", "event": "click" },
    { "type": "await", "observable": "network-editor-open", "equals": true },
    { "type": "write", "target": "wifi-password", "text": "fixture/pass" },
    { "type": "key", "target": "wifi-password", "key": "Enter" },
    { "type": "await", "observable": "wifi-state", "equals": "completed" },
    { "type": "expect", "observable": "wifi-guest-connected", "equals": true },
    { "type": "expect", "observable": "password-length", "equals": 0 }
  ]
}
