{
  "version": 1,
  "key": "action-menu-wifi-lifecycle",
  "target": { "story": "action-menu-wifi" },
  "steps": [
    { "type": "reset" },
    { "type": "await", "observable": "menu-ready", "equals": true },
    { "type": "pointer", "target": "wifi-secured", "event": "click" },
    { "type": "write", "target": "wifi-password", "text": "fixture/pass" },
    { "type": "expect", "observable": "password-length", "equals": 12 },
    { "type": "pointer", "target": "scene", "event": "click", "x": 0.1, "y": 0.1 },
    { "type": "await", "observable": "menu-open", "equals": false },
    { "type": "expect", "observable": "password-length", "equals": 0 },
    { "type": "expect", "observable": "network-editor-open", "equals": false },
    { "type": "reset" },
    { "type": "control", "group": "networks", "option": "next-connect-fails" },
    { "type": "await", "observable": "menu-ready", "equals": true },
    { "type": "pointer", "target": "wifi-secured", "event": "click" },
    { "type": "write", "target": "wifi-password", "text": "fixture/pass" },
    { "type": "key", "target": "wifi-password", "key": "Enter" },
    { "type": "pointer", "target": "scene", "event": "click", "x": 0.1, "y": 0.1 },
    { "type": "await", "observable": "menu-open", "equals": false },
    { "type": "await", "observable": "wifi-state", "equals": "failed" },
    { "type": "expect", "observable": "network-editor-open", "equals": false },
    { "type": "expect", "observable": "password-length", "equals": 0 },
    { "type": "expect", "observable": "input-region", "equals": "search" },
    { "type": "reset" },
    { "type": "control", "group": "networks", "option": "vpn-without-wi-fi" },
    { "type": "await", "observable": "menu-ready", "equals": true },
    { "type": "expect", "observable": "wifi-available", "equals": false },
    { "type": "expect", "observable": "vpn-selectable", "equals": true },
    { "type": "pointer", "target": "vpn-row", "event": "click" },
    { "type": "await", "observable": "vpn-active", "equals": true },
    { "type": "key", "target": "menu", "key": "Enter" },
    { "type": "expect", "observable": "confirmation", "equals": "vpn-off" },
    { "type": "expect", "observable": "vpn-active", "equals": true },
    { "type": "pointer", "target": "vpn-row", "event": "click" },
    { "type": "await", "observable": "vpn-active", "equals": false },
    { "type": "control", "group": "networks", "option": "unavailable" },
    { "type": "expect", "observable": "vpn-selectable", "equals": false },
    { "type": "reset" },
    { "type": "await", "observable": "menu-ready", "equals": true },
    { "type": "pointer", "target": "wifi-rescan", "event": "click" },
    { "type": "expect", "observable": "wifi-scanning", "equals": true },
    { "type": "expect", "observable": "wifi-scan-reading", "equals": "Scanning…" },
    { "type": "await", "observable": "wifi-scanning", "equals": false },
    { "type": "expect", "observable": "wifi-scan-reading", "equals": "Refresh available networks" }
  ]
}
