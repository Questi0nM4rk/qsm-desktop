{
  "version": 1,
  "key": "notification-api-replacement",
  "target": { "story": "notification-layer" },
  "steps": [
    { "type": "reset" },
    { "type": "action", "name": "publish-default" },
    { "type": "expect", "observable": "latest-app-name", "equals": "qsm-desktop" },
    { "type": "expect", "observable": "latest-body", "equals": "" },
    { "type": "expect", "observable": "latest-urgency", "equals": "normal" },
    { "type": "expect", "observable": "latest-expiry-ms", "equals": 5000 },
    { "type": "await", "observable": "rollout-open", "equals": true },
    { "type": "control", "group": "urgency", "option": "low" },
    { "type": "action", "name": "replace-transfer" },
    { "type": "await", "observable": "replacement-kept-row", "equals": true },
    { "type": "expect", "observable": "latest-urgency", "equals": "low" },
    { "type": "expect", "observable": "latest-expiry-ms", "equals": 3000 },
    { "type": "control", "group": "urgency", "option": "critical" },
    { "type": "control", "group": "timeout", "option": "urgency-default" },
    { "type": "action", "name": "replace-transfer" },
    { "type": "await", "observable": "replacement-kept-row", "equals": true },
    { "type": "expect", "observable": "latest-expiry-ms", "equals": -1 },
    { "type": "control", "group": "timeout", "option": "sticky" },
    { "type": "action", "name": "replace-transfer" },
    { "type": "await", "observable": "replacement-kept-row", "equals": true },
    { "type": "expect", "observable": "latest-urgency", "equals": "critical" },
    { "type": "expect", "observable": "latest-expiry-ms", "equals": 0 },
    { "type": "expect", "observable": "transfer-summary", "equals": "Transfer complete" },
    { "type": "control", "group": "timeout", "option": "250ms-override" },
    { "type": "action", "name": "replace-transfer" },
    { "type": "await", "observable": "replacement-kept-row", "equals": true },
    { "type": "expect", "observable": "latest-expiry-ms", "equals": 250 },
    { "type": "action", "name": "publish-invalid" },
    { "type": "expect", "observable": "rejected-field", "equals": "urgency" },
    { "type": "expect", "observable": "live-count", "equals": 1 }
  ]
}
