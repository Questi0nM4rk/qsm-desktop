{
  "version": 1,
  "key": "notification-fullscreen-retarget-reset",
  "target": { "story": "notification-layer" },
  "steps": [
    { "type": "reset" },
    { "type": "environment", "mode": "fullscreen" },
    { "type": "control", "group": "policy", "option": "reduced-motion" },
    { "type": "expect", "observable": "reduced-motion", "equals": true },
    { "type": "action", "name": "publish-transfer" },
    { "type": "await", "observable": "fullscreen-mask-count", "equals": 1 },
    { "type": "expect", "observable": "fullscreen-mask-ids", "equals": ["notify-row-1"] },
    { "type": "action", "name": "dismiss-newest" },
    { "type": "await", "observable": "fullscreen-mask-count", "equals": 0 },
    { "type": "await", "observable": "rollout-closing", "equals": true },
    { "type": "action", "name": "arrive-during-retract" },
    { "type": "await", "observable": "live-count", "equals": 1 },
    { "type": "await", "observable": "rollout-open", "equals": true },
    { "type": "expect", "observable": "fullscreen-mask-count", "equals": 1 },
    { "type": "reset" },
    { "type": "await", "observable": "rollout-visible", "equals": false },
    { "type": "await", "observable": "row-geometry", "equals": [] },
    { "type": "expect", "observable": "reset-presentation-pending", "equals": false },
    { "type": "action", "name": "publish-short" },
    { "type": "expect", "observable": "live-ids", "equals": [1] },
    { "type": "action", "name": "reset" },
    { "type": "await", "observable": "rollout-visible", "equals": false },
    { "type": "await", "observable": "row-geometry", "equals": [] },
    { "type": "expect", "observable": "reset-presentation-pending", "equals": false },
    { "type": "action", "name": "watch-reset-cancellation" },
    { "type": "await", "observable": "reset-observation-window", "equals": true },
    { "type": "expect", "observable": "live-count", "equals": 0 },
    { "type": "expect", "observable": "expiry-completions", "equals": 0 }
  ]
}
