{
  "version": 1,
  "key": "osd-label-action",
  "target": { "story": "osd-layer" },
  "steps": [
    { "type": "reset" },
    { "type": "action", "name": "present-output" },
    { "type": "await", "observable": "osd-visible", "equals": true },
    { "type": "await", "observable": "reveal-progress", "equals": 1 },
    { "type": "expect", "observable": "can-toggle-output-mute", "equals": true },
    { "type": "pointer", "target": "output-mute", "event": "click" },
    { "type": "expectEvent", "event": "label-clicked", "origin": "component", "payload": { "action": "output-mute", "target": "output" } },
    { "type": "expect", "observable": "output-muted", "equals": true },
    { "type": "expect", "observable": "output-value", "equals": 0.62 },
    { "type": "key", "target": "output-mute", "key": "Space" },
    { "type": "expect", "observable": "output-muted", "equals": false },
    { "type": "expect", "observable": "output-value", "equals": 0.62 },
    { "type": "action", "name": "toggle-output-mute" },
    { "type": "expect", "observable": "output-muted", "equals": true },
    { "type": "expect", "observable": "output-value", "equals": 0.62 },
    { "type": "action", "name": "present-microphone" },
    { "type": "expect", "observable": "can-toggle-microphone-mute", "equals": true },
    { "type": "action", "name": "toggle-microphone-mute" },
    { "type": "expect", "observable": "microphone-muted", "equals": true },
    { "type": "expect", "observable": "microphone-value", "equals": 0.38 },
    { "type": "control", "group": "microphone-availability", "option": "unavailable" },
    { "type": "expect", "observable": "can-toggle-microphone-mute", "equals": false },
    { "type": "control", "group": "microphone-availability", "option": "available" },
    { "type": "environment", "mode": "fullscreen" },
    { "type": "expect", "observable": "fullscreen", "equals": true },
    { "type": "expect", "observable": "presentation", "equals": "capsule" },
    { "type": "action", "name": "toggle-microphone-mute" },
    { "type": "expect", "observable": "microphone-muted", "equals": false },
    { "type": "expect", "observable": "microphone-value", "equals": 0.38 },
    { "type": "environment", "mode": "desktop" },
    { "type": "expect", "observable": "fullscreen", "equals": false },
    { "type": "expect", "observable": "presentation", "equals": "rollout" }
  ]
}
