{
  "version": 1, "key": "panel-resources-input",
  "target": { "story": "panel-resources" },
  "steps": [
    { "type": "reset" },
    { "type": "expect", "observable": "cpu-reading", "equals": "23%" },
    { "type": "expect", "observable": "panel-open", "equals": false },
    { "type": "pointer", "target": "handle", "event": "click" },
    { "type": "expect", "observable": "panel-open", "equals": true },
    { "type": "control", "group": "resources", "option": "unavailable" },
    { "type": "expect", "observable": "cpu-reading", "equals": "—" },
    { "type": "expect", "observable": "memory-reading", "equals": "—" },
    { "type": "control", "group": "suppress", "option": "focus-mode" },
    { "type": "expect", "observable": "handle-visible", "equals": false },
    { "type": "reset" },
    { "type": "expect", "observable": "handle-visible", "equals": true }
  ]
}
