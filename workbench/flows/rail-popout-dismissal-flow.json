{
  "version": 1,
  "key": "rail-popout-dismissal-flow",
  "target": { "story": "rail-popouts" },
  "steps": [
    { "type": "reset" },
    { "type": "pointer", "target": "rail-actions", "event": "move" },
    { "type": "await", "observable": "parent-settled", "equals": true },
    { "type": "expect", "observable": "parent-kind", "equals": "actions" },
    { "type": "pointer", "target": "night-light", "event": "move" },
    { "type": "await", "observable": "child-kind", "equals": "nightlight" },
    { "type": "await", "observable": "child-settled", "equals": true },
    { "type": "expect", "observable": "night-light-readout", "equals": "Off · drag to warm the screen" },
    { "type": "pointer", "target": "night-light", "event": "click" },
    { "type": "expect", "observable": "night-light-active", "equals": true },
    { "type": "expect", "observable": "night-light-readout", "equals": "Warmth 51% · 4200K" },
    { "type": "pointer", "target": "warmth", "event": "click", "x": 0.5, "y": 0.5 },
    { "type": "expect", "observable": "night-light-active", "equals": true },
    { "type": "key", "target": "warmth", "key": "Home" },
    { "type": "expect", "observable": "night-light-readout", "equals": "Warmth 0% · 6000K" },
    { "type": "key", "target": "warmth", "key": "End" },
    { "type": "expect", "observable": "night-light-readout", "equals": "Warmth 100% · 2500K" },
    { "type": "pointer", "target": "warmth", "event": "wheel", "dx": 0, "dy": -120 },
    { "type": "expect", "observable": "night-light-readout", "equals": "Warmth 95% · 2675K" },
    { "type": "pointer", "target": "warmth", "event": "wheel", "dx": 0, "dy": 240 },
    { "type": "expect", "observable": "night-light-readout", "equals": "Warmth 100% · 2500K" },
    { "type": "pointer", "target": "night-light", "event": "move" },
    { "type": "pointer", "target": "outside", "event": "move" },
    { "type": "pointer", "target": "night-light", "event": "move" },
    { "type": "expect", "observable": "child-kind", "equals": "nightlight" },
    { "type": "expect", "observable": "parent-kind", "equals": "actions" },
    { "type": "expect", "observable": "child-held", "equals": true },
    { "type": "expect", "observable": "night-light-readout", "equals": "Warmth 100% · 2500K" },
    { "type": "pointer", "target": "outside", "event": "move" },
    { "type": "await", "observable": "child-kind", "equals": "" },
    { "type": "await", "observable": "parent-kind", "equals": "" },
    { "type": "expectEvent", "event": "dismissed", "origin": "component", "payload": { "level": "child", "kind": "", "title": "Night light" } },
    { "type": "expect", "observable": "night-light-active", "equals": true },
    { "type": "pointer", "target": "rail-actions", "event": "move" },
    { "type": "await", "observable": "parent-opening", "equals": true },
    { "type": "pointer", "target": "outside", "event": "move" },
    { "type": "await", "observable": "parent-kind", "equals": "" },
    { "type": "expectEvent", "event": "dismissed", "origin": "component", "payload": { "level": "parent", "kind": "", "title": "Quick actions" } },
    { "type": "await", "observable": "parent-settled", "equals": true },
    { "type": "expect", "observable": "parent-visible", "equals": false },
    { "type": "reset" },
    { "type": "expect", "observable": "night-light-active", "equals": false },
    { "type": "expect", "observable": "night-light-temperature", "equals": 4200 },
    { "type": "pointer", "target": "rail-actions", "event": "move" },
    { "type": "await", "observable": "parent-settled", "equals": true },
    { "type": "expectEvent", "event": "opened", "origin": "component", "payload": { "level": "parent", "kind": "actions", "title": "Quick actions" } },
    { "type": "pointer", "target": "night-light", "event": "move" },
    { "type": "await", "observable": "child-kind", "equals": "nightlight" },
    { "type": "expect", "observable": "night-light-readout", "equals": "Off · drag to warm the screen" }
  ]
}
