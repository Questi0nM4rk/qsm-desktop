{
  "version": 1,
  "key": "rail-popout-retention-flow",
  "target": { "story": "rail-popouts" },
  "steps": [
    { "type": "reset" },
    { "type": "pointer", "target": "rail-actions", "event": "move" },
    { "type": "await", "observable": "parent-settled", "equals": true },
    { "type": "pointer", "target": "colours", "event": "move" },
    { "type": "await", "observable": "child-kind", "equals": "colorpick" },
    { "type": "await", "observable": "child-settled", "equals": true },
    { "type": "expect", "observable": "child-held", "equals": true },
    { "type": "pointer", "target": "pick-colour", "event": "click" },
    { "type": "await", "observable": "color-busy", "equals": true },
    { "type": "expect", "observable": "color-busy-visible", "equals": true },
    { "type": "expect", "observable": "color-busy-line", "equals": "Picking…" },
    { "type": "await", "observable": "color-busy", "equals": false },
    { "type": "expect", "observable": "color", "equals": "#9FC2EA" },
    { "type": "expect", "observable": "copied", "equals": "#9FC2EA" },
    { "type": "expect", "observable": "color-copy-feedback", "equals": "check" },
    { "type": "pointer", "target": "outside", "event": "move" },
    { "type": "control", "group": "keyboard", "option": "retained" },
    { "type": "await", "observable": "child-kind", "equals": "colorpick" },
    { "type": "await", "observable": "child-held", "equals": false },
    { "type": "expect", "observable": "child-kind", "equals": "colorpick" },
    { "type": "expect", "observable": "parent-kind", "equals": "actions" },
    { "type": "control", "group": "keyboard", "option": "released" },
    { "type": "await", "observable": "child-kind", "equals": "" },
    { "type": "expectEvent", "event": "dismissed", "origin": "component", "payload": { "level": "child", "kind": "", "title": "Colours" } },
    { "type": "await", "observable": "parent-kind", "equals": "" },
    { "type": "expectEvent", "event": "dismissed", "origin": "component", "payload": { "level": "parent", "kind": "", "title": "Quick actions" } },
    { "type": "pointer", "target": "rail-actions", "event": "move" },
    { "type": "await", "observable": "parent-settled", "equals": true },
    { "type": "expect", "observable": "parent-kind", "equals": "actions" },
    { "type": "control", "group": "suppression", "option": "fullscreen" },
    { "type": "expect", "observable": "suppressed", "equals": true },
    { "type": "await", "observable": "parent-visible", "equals": false },
    { "type": "expect", "observable": "parent-kind", "equals": "" },
    { "type": "control", "group": "suppression", "option": "interactive" },
    { "type": "expect", "observable": "suppressed", "equals": false },
    { "type": "expect", "observable": "parent-visible", "equals": false },
    { "type": "pointer", "target": "outside", "event": "move" },
    { "type": "pointer", "target": "rail-actions", "event": "move" },
    { "type": "await", "observable": "parent-settled", "equals": true },
    { "type": "expectEvent", "event": "opened", "origin": "component", "payload": { "level": "parent", "kind": "actions", "title": "Quick actions" } },
    { "type": "expect", "observable": "parent-visible", "equals": true },
    { "type": "pointer", "target": "outside", "event": "move" },
    { "type": "await", "observable": "parent-kind", "equals": "" },
    { "type": "control", "group": "motion", "option": "reduced-motion" },
    { "type": "expect", "observable": "reduced-motion", "equals": true },
    { "type": "pointer", "target": "rail-actions", "event": "move" },
    { "type": "await", "observable": "parent-settled", "equals": true },
    { "type": "expect", "observable": "parent-kind", "equals": "actions" },
    { "type": "expect", "observable": "parent-visible", "equals": true },
    { "type": "control", "group": "motion", "option": "full-motion" },
    { "type": "expect", "observable": "reduced-motion", "equals": false },
    { "type": "pointer", "target": "outside", "event": "move" },
    { "type": "await", "observable": "parent-kind", "equals": "" },
    { "type": "reset" },
    { "type": "expect", "observable": "color", "equals": "#C5A5E9" },
    { "type": "expect", "observable": "copied", "equals": "" },
    { "type": "expect", "observable": "keyboard-retained", "equals": false },
    { "type": "expect", "observable": "suppressed", "equals": false },
    { "type": "expect", "observable": "reduced-motion", "equals": false },
    { "type": "expect", "observable": "parent-kind", "equals": "" },
    { "type": "pointer", "target": "rail-actions", "event": "move" },
    { "type": "await", "observable": "parent-settled", "equals": true },
    { "type": "expectEvent", "event": "opened", "origin": "component", "payload": { "level": "parent", "kind": "actions", "title": "Quick actions" } },
    { "type": "expect", "observable": "parent-visible", "equals": true }
  ]
}
